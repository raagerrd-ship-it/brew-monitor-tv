[Unit]
Description=Brew Control Regulator (PID + Relay + Cloud Sync)
After=network-online.target brew-control-web.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/brew-control
Environment=GPIOZERO_PIN_FACTORY=lgpio
EnvironmentFile=%h/brew-control/.env
ExecStart=%h/brew-control/.venv/bin/python3 regulator.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
