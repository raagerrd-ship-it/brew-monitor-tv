[Unit]
Description=Brew control local web UI (PT100 calibration)
After=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/brew-control
Environment=GPIOZERO_PIN_FACTORY=lgpio
Environment=BREW_CONTROL_DATA=/home/pi/brew-control
ExecStart=/home/pi/brew-control/.venv/bin/python web.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target